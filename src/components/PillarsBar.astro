---
import Icon from "./Icon.astro";

const pillars = [
  {
    icon: "scan",
    title: "Diagnóstico Digital 3D",
    desc: "Análisis microscópico de 8 capas dérmicas",
  },
  {
    icon: "sparkles",
    title: "Cosmecéutica Suiza",
    desc: "Fórmulas biotecnológicas de grado médico",
  },
  {
    icon: "feather",
    title: "Protocolos 100% Sin Dolor",
    desc: "Terapias no invasivas de máxima eficacia",
  },
  {
    icon: "gem",
    title: "Suites Privadas",
    desc: "Atención individual y privacidad absoluta",
  },
];

const numerals = ["i", "ii", "iii", "iv"];
---

<section class="bg-obsidian text-pearl">
  <div class="shell">
    <div class="hairline text-pearl"></div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {
        pillars.map((pillar, i) => (
          <div
            data-reveal
            class:list={[
              "group flex flex-col gap-5 py-10 sm:px-8",
              i > 0 && "border-t border-white/[0.07] sm:border-t-0",
              i % 2 === 1 && "sm:border-l sm:border-white/[0.07]",
              i === 2 && "lg:border-l lg:border-white/[0.07] sm:pl-0 lg:pl-8",
              i === 0 && "sm:pl-0",
            ]}
          >
            <div class="flex items-center justify-between">
              <span class="font-display text-2xl text-champagne/70 italic">{numerals[i]}.</span>
              <span class="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 transition-colors duration-500 group-hover:border-champagne/50 group-hover:bg-champagne/10">
                <Icon name={pillar.icon} class="h-4 w-4 text-champagne" strokeWidth={1.5} />
              </span>
            </div>
            <div class="flex flex-col gap-1.5">
              <p class="font-display text-[24px] leading-tight">{pillar.title}</p>
              <p class="text-[13px] leading-relaxed text-pearl/50">{pillar.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
