---
import Icon from "./Icon.astro";

const treatments = [
  {
    image: "/images/tr-hydraluxe.jpg",
    alt: "Infusión celular Hydra-Luxe",
    tag: "Hidratación & Luz",
    title: "Hydra-Luxe Infusión Celular",
    desc: "Limpieza hidrodinámica con activos biofermentados, ácido hialurónico triple y oxigenación para un resplandor inmediato.",
    badge: "75 min • Cero dolor",
  },
  {
    image: "/images/tr-sculpt.jpg",
    alt: "Bio-radiofrecuencia Sculpt & Lift",
    tag: "Firmeza & Contorno",
    title: "Sculpt & Lift Bio-Radiofrecuencia",
    desc: "Tensado cutáneo y bioestimulación profunda de colágeno y elastina. Redefine el óvalo facial con efecto tensor visible.",
    badge: "90 min • Efecto tensor",
  },
  {
    image: "/images/tr-glowpeel.jpg",
    alt: "Glow Peel biorevitalizante",
    tag: "Renovación Sedosa",
    title: "Glow Peel Biorevitalizante",
    desc: "Exfoliación suave con alfa-hidroxiácidos de seda, niacinamida pura y péptidos regenerativos para una piel ultra suave.",
    badge: "60 min • Sin descamación",
  },
  {
    image: "/images/tr-exosomas.jpg",
    alt: "Terapia de exosomas y longevidad",
    tag: "Medicina Celular Regenerativa",
    title: "Terapia de Exosomas & Longevidad",
    desc: "El tratamiento más vanguardista de longevidad cutánea: bio-infusión de factores de crecimiento para reprogramación celular dérmica.",
    badge: "90 min • Rejuvenecimiento supremo",
  },
];
---

<section id="tratamientos" class="relative isolate overflow-hidden bg-pearl">
  <div class="orb -top-24 right-[-10%] h-[420px] w-[420px] bg-champagne-soft/80" aria-hidden="true"></div>

  <div class="shell flex flex-col gap-16 py-24 lg:py-32">
    <div class="grid grid-cols-1 items-end gap-8 lg:grid-cols-12" data-reveal-stagger>
      <div class="flex flex-col gap-6 lg:col-span-7">
        <p class="kicker text-champagne-deep" data-reveal>
          <span class="kicker-num">01</span> Catálogo de Alta Cosmetología
        </p>
        <h2 class="section-title text-ink" data-reveal>
          Protocolos exclusivos de <em class="text-champagne-deep">precisión celular</em>
        </h2>
      </div>
      <div class="flex flex-col items-start gap-6 lg:col-span-4 lg:col-start-9" data-reveal>
        <p class="text-[15px] leading-[1.75] text-ink-soft">
          Fórmulas biotecnológicas suizas y tecnología no invasiva para renovar la arquitectura de tu
          piel.
        </p>
        <a href="#reservas" class="link-arrow text-ink hover:text-champagne-deep">
          Agendar valoración <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
        </a>
      </div>
    </div>

    <div class="grid w-full grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4 xl:pb-16" data-reveal-stagger>
      {
        treatments.map((treatment, i) => (
          <article
            data-reveal
            tabindex="0"
            class:list={[
              "treatment-card img-zoom group relative isolate flex aspect-[3/4.1] flex-col justify-between overflow-hidden rounded-[30px] p-3 outline-none focus-visible:ring-2 focus-visible:ring-champagne",
              i % 2 === 1 && "xl:translate-y-16",
            ]}
          >
            <img
              src={treatment.image}
              alt={treatment.alt}
              loading="lazy"
              class="absolute inset-0 -z-10 h-full w-full object-cover"
            />
            <div class="absolute inset-0 -z-10 bg-linear-to-t from-obsidian/70 via-obsidian/5 to-obsidian/20"></div>

            <div class="flex items-start justify-between gap-3">
              <span class="glass glass-tint rounded-full px-3.5 py-1.5 text-[10px] font-semibold tracking-[0.16em] text-pearl uppercase">
                {treatment.tag}
              </span>
              <span class="glass flex h-10 w-10 shrink-0 items-center justify-center rounded-full font-display text-sm text-pearl italic">
                0{i + 1}
              </span>
            </div>

            <div class="glass glass-tint glass-sheen rounded-[24px] p-5">
              <h3 class="font-display text-[26px] leading-[1.05] text-pearl">{treatment.title}</h3>
              <div class="treatment-desc">
                <div class="overflow-hidden">
                  <p class="pt-3 text-[13px] leading-[1.65] text-pearl/70">{treatment.desc}</p>
                </div>
              </div>
              <div class="mt-4 flex items-center justify-between gap-3 border-t border-white/15 pt-3">
                <span class="inline-flex items-center gap-2 text-[11px] text-champagne-soft">
                  <Icon name="check" class="h-3 w-3 text-champagne" strokeWidth={2.5} />
                  {treatment.badge}
                </span>
                <Icon
                  name="arrow-up-right"
                  class="h-4 w-4 text-pearl/60 transition-transform duration-500 group-hover:rotate-45 group-hover:text-champagne"
                />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
