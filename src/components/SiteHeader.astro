---
import Icon from "./Icon.astro";

const links = [
  { label: "Inicio", href: "#inicio" },
  { label: "Tratamientos", href: "#tratamientos" },
  { label: "Especialistas", href: "#especialistas" },
  { label: "Experiencia", href: "#experiencia" },
  { label: "Reservas", href: "#reservas" },
];
---

<header class="site-header">
  <div class="shell pt-3">
    <div class="header-bar glass glass-tint">
      <a href="#inicio" class="flex items-center gap-3" aria-label="ALBA DÉRMICA - Inicio">
        <span
          class="flex h-10 w-10 items-center justify-center rounded-full border border-champagne/50 font-display text-[17px] text-champagne italic"
        >
          ad
        </span>
        <span class="flex flex-col leading-none">
          <span class="font-display text-[21px] font-medium tracking-[0.02em] whitespace-nowrap text-pearl">
            Alba Dérmica
          </span>
          <span class="mt-1 hidden text-[8.5px] font-semibold tracking-[0.3em] whitespace-nowrap text-champagne/80 sm:block">
            ATELIER FACIAL &amp; REGENERACIÓN
          </span>
        </span>
      </a>

      <nav class="hidden items-center gap-8 xl:flex" aria-label="Navegación principal">
        {
          links.map((link) => (
            <a href={link.href} class="nav-link" data-nav>
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden items-center gap-2 xl:flex">
        <a
          href="https://wa.me/593998421900"
          class="btn gap-2 rounded-full px-4 py-2.5 text-[12px] text-pearl/75 hover:text-pearl"
        >
          <Icon name="message-circle" class="h-3.5 w-3.5 text-champagne" />
          WhatsApp
        </a>
        <a
          href="#reservas"
          class="btn btn-shine rounded-full bg-champagne px-5 whitespace-nowrap py-3 text-[12px] text-obsidian hover:bg-champagne-soft"
        >
          Reservar Cita
          <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
        </a>
      </div>

      <button
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-pearl xl:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span data-icon-menu><Icon name="menu" class="h-[18px] w-[18px]" /></span>
        <span data-icon-close class="hidden"><Icon name="x" class="h-[18px] w-[18px]" /></span>
      </button>
    </div>

    <div class="mobile-menu glass xl:hidden" data-mobile-menu>
      <nav class="flex flex-col gap-1" aria-label="Navegación móvil">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="rounded-2xl px-4 py-3 font-display text-2xl text-pearl/85 transition-colors hover:bg-white/5 hover:text-champagne"
            >
              {link.label}
            </a>
          ))
        }
        <a href="#reservas" class="btn btn-shine mt-2 w-full bg-champagne py-4 text-obsidian">
          Reservar Cita
        </a>
      </nav>
    </div>
  </div>
</header>
