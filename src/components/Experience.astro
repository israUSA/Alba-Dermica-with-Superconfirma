---
const cards = [
  {
    image: "/images/exp-diagnostico.jpg",
    alt: "Suite privada del atelier Alba Dérmica",
    tag: "Privacidad Absoluta",
    title: "Suites Privadas Individuales",
    desc: "Cabinas insonorizadas con aromaterapia botánica personalizada, sábanas de lino orgánico y música ambiental relajante.",
  },
  {
    image: "/images/exp-suites.jpg",
    alt: "Diagnóstico digital computarizado de la piel",
    tag: "Tecnología Suiza 3D",
    title: "Diagnóstico Digital Computarizado",
    desc: "Escaneo dérmico que evalúa el daño solar profundo, densidad de colágeno y poros para un tratamiento 100% a la medida.",
  },
  {
    image: "/images/exp-atencion.jpg",
    alt: "Atención exclusiva sin prisas",
    tag: "Tiempo Dedicado",
    title: "Atención Exclusiva Sin Prisas",
    desc: "Solo atendemos un número limitado de citas diarias para garantizar un trato minucioso y seguimiento médico post-tratamiento.",
  },
];

const layout = [
  "lg:col-span-7 lg:row-span-2 min-h-[520px] lg:min-h-[760px]",
  "lg:col-span-5 min-h-[420px]",
  "lg:col-span-5 min-h-[420px]",
];
---

<section id="experiencia" class="relative isolate overflow-hidden bg-pearl-2">
  <div class="orb bottom-0 -left-40 h-[460px] w-[460px] bg-sage/30" aria-hidden="true"></div>

  <div class="shell flex flex-col gap-16 py-24 lg:py-32">
    <div class="grid grid-cols-1 items-end gap-8 lg:grid-cols-12" data-reveal-stagger>
      <div class="flex flex-col gap-6 lg:col-span-7">
        <p class="kicker text-champagne-deep" data-reveal>
          <span class="kicker-num">03</span> El Atelier Alba Dérmica
        </p>
        <h2 class="section-title text-ink" data-reveal>
          Un santuario de <em class="text-sage-deep">calma</em> y rigor clínico
        </h2>
      </div>
      <p class="text-[15px] leading-[1.75] text-ink-soft lg:col-span-4 lg:col-start-9" data-reveal>
        Cada cita se desarrolla en una atmósfera privada donde la biotecnología médica se fusiona
        con la indulgencia sensorial.
      </p>
    </div>

    <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-12" data-reveal-stagger>
      {
        cards.map((card, i) => (
          <article
            data-reveal
            class:list={[
              "img-zoom group relative isolate flex flex-col justify-end overflow-hidden rounded-[32px] p-3 sm:p-4",
              layout[i],
            ]}
          >
            <img
              src={card.image}
              alt={card.alt}
              loading="lazy"
              class="absolute inset-0 -z-10 h-full w-full object-cover"
            />
            <div class="absolute inset-0 -z-10 bg-linear-to-t from-obsidian/35 to-transparent"></div>

            <div
              class:list={[
                "glass-light glass-sheen rounded-[24px] p-6",
                i === 0 ? "max-w-[440px]" : "max-w-[380px]",
              ]}
            >
              <p class="text-[10px] font-semibold tracking-[0.2em] text-champagne-deep uppercase">
                {card.tag}
              </p>
              <h3 class:list={["mt-2 font-display leading-[1.05] text-ink", i === 0 ? "text-[34px]" : "text-[28px]"]}>
                {card.title}
              </h3>
              <p class="mt-3 text-[13px] leading-[1.65] text-ink-soft">{card.desc}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
