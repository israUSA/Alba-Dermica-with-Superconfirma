---
import Icon from "./Icon.astro";

const chips = [
  "Hydra-Luxe Infusión",
  "Sculpt & Lift Radiofrecuencia",
  "Glow Peel Biorevitalizante",
  "Terapia de Exosomas",
  "Diagnóstico 3D & Spa",
];

const specialists = [
  {
    initials: "cl",
    name: "Dra. Camille Laurent",
    role: "Directora Científica • Longevidad Cutánea",
    uni: "PhD en Biología Celular Cutánea (París)",
    status: "Disponible: Hoy y Mañana",
    selected: true,
  },
  {
    initials: "sb",
    name: "Lic. Sofia Benavides",
    role: "Máster en Terapias Suizas & Remodelación",
    uni: "Certificación Instituto Dérmico de Ginebra",
    status: "Disponible: Jueves y Viernes",
    selected: false,
  },
  {
    initials: "mv",
    name: "Dr. Mateo Valenzuela",
    role: "Médico Estético & Bioestimulación",
    uni: "Especialista en Regeneración Tisular",
    status: "Disponible: Próx. Semana",
    selected: false,
  },
];

const days = [
  { day: "Jue 1", month: "Octubre", selected: true },
  { day: "Vie 2", month: "Octubre" },
  { day: "Lun 5", month: "Octubre" },
  { day: "Mar 6", month: "Octubre" },
];

const hours = ["10:30 AM", "12:00 PM", "04:30 PM", "06:00 PM"];
const selectedHour = "12:00 PM";

const notes = [
  { icon: "calendar-check", text: "Cancelación flexible 24h sin costo" },
  { icon: "shield-check", text: "100% de confidencialidad médica garantizada" },
  { icon: "message-circle", text: "Confirmación inmediata por WhatsApp" },
];

const fields = [
  { id: "alba-name", label: "Nombre Completo", icon: "user", name: "nombre", type: "text", value: "Carolina Méndez L.", autocomplete: "name" },
  { id: "alba-phone", label: "WhatsApp / Teléfono", icon: "phone", name: "telefono", type: "tel", value: "+593 99 123 4567", autocomplete: "tel" },
  { id: "alba-email", label: "Correo Electrónico", icon: "mail", name: "email", type: "email", value: "carolina.mendez@luxury.com", autocomplete: "email" },
];
---

<section id="reservas" class="relative isolate overflow-hidden bg-obsidian text-pearl">
  <div class="orb top-20 -left-32 h-[520px] w-[520px] bg-sage-deep/60" aria-hidden="true"></div>
  <div class="orb right-[-8%] bottom-10 h-[560px] w-[560px] bg-champagne/20" aria-hidden="true"></div>
  <div class="orb top-1/2 left-1/2 h-[300px] w-[300px] bg-sage/20" aria-hidden="true"></div>

  <div class="shell flex flex-col gap-14 py-24 lg:py-32">
    <div class="grid grid-cols-1 items-end gap-8 lg:grid-cols-12" data-reveal-stagger>
      <div class="flex flex-col gap-6 lg:col-span-7">
        <p class="kicker text-champagne" data-reveal>
          <span class="kicker-num">02</span> Atelier Privado de Citas &amp; Valoración
        </p>
        <h2 class="section-title" data-reveal>
          Agenda tu experiencia de <em class="text-champagne">transformación facial</em>
        </h2>
      </div>
      <p class="text-[15px] leading-[1.75] text-pearl/60 lg:col-span-4 lg:col-start-9" data-reveal>
        Selecciona tu protocolo de interés, elige a tu especialista de confianza y asegura tu
        espacio prioritario en suite privada.
      </p>
    </div>

    <div data-reveal="zoom" class="glass glass-sheen rounded-[36px] px-6 pt-2 pb-8 sm:px-10 lg:px-12 lg:pb-12">
      <div class="step border-t-0">
        <div class="step-label">
          <span class="step-num">i.</span>
          <p class="step-text">Selecciona el protocolo o tratamiento de tu interés</p>
        </div>
        <div class="flex flex-wrap gap-2.5" data-select-group>
          {
            chips.map((chip, index) => (
              <button
                type="button"
                data-select-option
                class:list={["chip", index === 0 && "is-selected"]}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <Icon name="check" class="h-3 w-3" strokeWidth={3} />
                {chip}
              </button>
            ))
          }
        </div>
      </div>

      <div id="especialistas" class="step">
        <div class="step-label">
          <span class="step-num">ii.</span>
          <p class="step-text">Elige a tu especialista disponible</p>
        </div>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-3" data-select-group data-group-specialists>
          {
            specialists.map((doctor) => (
              <button
                type="button"
                data-select-option
                data-specialist-name={doctor.name}
                class:list={["doc-card", doctor.selected && "is-selected"]}
                aria-pressed={doctor.selected ? "true" : "false"}
              >
                <span class="flex items-center justify-between gap-3">
                  <span class="doc-avatar">{doctor.initials}</span>
                  <span class="doc-radio">
                    <Icon name="check" class="radio-check" strokeWidth={3} />
                  </span>
                </span>
                <span class="flex flex-col gap-1">
                  <span class="font-display text-[22px] leading-tight text-pearl">{doctor.name}</span>
                  <span class="text-xs text-champagne">{doctor.role}</span>
                  <span class="text-[11px] text-pearl/45">{doctor.uni}</span>
                </span>
                <span class="mt-auto inline-flex w-fit items-center gap-1.5 text-[10px] font-medium tracking-[0.04em] text-live">
                  <span class="h-1.5 w-1.5 rounded-full bg-live"></span>
                  {doctor.status}
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="step">
        <div class="step-label">
          <span class="step-num">iii.</span>
          <p class="step-text">Selecciona fecha y horario prioritario</p>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8">
          <div class="flex flex-col gap-3">
            <p class="text-[11px] tracking-[0.1em] text-pearl/45 uppercase">Día disponible</p>
            <div class="grid grid-cols-4 gap-2" data-select-group>
              {
                days.map((day) => (
                  <button
                    type="button"
                    data-select-option
                    class:list={["day-pill", day.selected && "is-selected"]}
                    aria-pressed={day.selected ? "true" : "false"}
                  >
                    <span class="day-text">{day.day}</span>
                    <span class="month-text">{day.month}</span>
                  </button>
                ))
              }
            </div>
          </div>
          <div class="flex flex-col gap-3">
            <p class="text-[11px] tracking-[0.1em] text-pearl/45 uppercase">Horario</p>
            <div class="grid grid-cols-4 gap-2" data-select-group>
              {
                hours.map((hour) => (
                  <button
                    type="button"
                    data-select-option
                    class:list={["hour-pill", hour === selectedHour && "is-selected"]}
                    aria-pressed={hour === selectedHour ? "true" : "false"}
                  >
                    {hour}
                  </button>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <div class="step">
        <div class="step-label">
          <span class="step-num">iv.</span>
          <p class="step-text">Datos de confirmación</p>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {
            fields.map((field) => (
              <div class="flex flex-col gap-1">
                <label for={field.id} class="text-[11px] tracking-[0.1em] text-pearl/45 uppercase">
                  {field.label}
                </label>
                <div class="input-box">
                  <Icon name={field.icon} class="h-3.5 w-3.5 shrink-0 text-champagne/70" />
                  <input
                    id={field.id}
                    name={field.name}
                    type={field.type}
                    value={field.value}
                    autocomplete={field.autocomplete}
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-6 border-t border-white/10 pt-8">
        <button type="submit" class="btn btn-confirm btn-shine">
          <Icon name="calendar-check" class="h-4.5 w-4.5 shrink-0" strokeWidth={2} />
          <span data-confirm-cta>
            Confirmar Cita de Valoración Privada con Dra. Camille Laurent
          </span>
        </button>

        <div class="flex flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap sm:gap-8">
          {
            notes.map((note) => (
              <div class="flex items-center gap-2">
                <Icon name={note.icon} class="h-3.5 w-3.5 shrink-0 text-champagne" />
                <p class="text-[11px] tracking-[0.03em] text-pearl/50">{note.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
